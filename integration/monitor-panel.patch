+
+  // ---- Auto brightness ------------------------------------------------
+  //
+  // The AUTO switch below is only a handle: every decision (which light
+  // source, what curve, when to stand down) belongs to the
+  // engida.autobrightness service, so the panel stays a view of it.
+  //
+  // Resolved imperatively, not as a binding on `root.bar.shell`. The bar is
+  // assigned to this widget *after* construction (Bar.qml does
+  // `target.bar = root`), and `bar` is typed QtObject, so a declarative chain
+  // through it evaluates once against null and never recovers. Re-resolve on
+  // the two events that can change the answer: the bar arriving, and the panel
+  // opening (by which time services have loaded).
+  property var autoBrightnessService: null
+
+  function resolveAutoBrightnessService() {
+    var barRef = root.bar
+    var shellRef = barRef ? barRef.shell : null
+    root.autoBrightnessService = (shellRef && typeof shellRef.serviceFor === "function")
+      ? shellRef.serviceFor("engida.autobrightness")
+      : null
+  }
+
+  onBarChanged: root.resolveAutoBrightnessService()
+  readonly property bool autoBrightnessEnabled: autoBrightnessService
+    ? autoBrightnessService.autoEnabled === true
+    : false
+  // Enabled but standing down, because the slider was moved by hand.
+  readonly property bool autoBrightnessPaused: autoBrightnessService
+    ? autoBrightnessService.paused === true
+    : false
+  // Which light source the service settled on, and why. Surfaced in the
+  // tooltip so the automatic choice is visible without running a CLI command.
+  readonly property string autoBrightnessSource: autoBrightnessService && autoBrightnessService.effectiveSource
+    ? String(autoBrightnessService.effectiveSource)
+    : ""
+  readonly property string autoBrightnessReason: autoBrightnessService
+    ? String(autoBrightnessService.sourceReason || "")
+    : ""
+
+  function toggleAutoBrightness() {
+    if (!root.autoBrightnessService) return
+    root.autoBrightnessService.toggle()
+  }
+
+  // Tapping the switch while paused is the clearest way to say "resume now",
+  // so a paused switch resumes instead of turning the feature off.
+  function activateAutoBrightness() {
+    if (!root.autoBrightnessService) return
+    if (root.autoBrightnessPaused) {
+      root.autoBrightnessService.resume()
+      return
+    }
+    root.toggleAutoBrightness()
+  }
